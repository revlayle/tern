// Raster interrupt: eight color bars in the border, one per band of 24 raster
// lines. The VIC-II interrupts at the start of each band; the handler picks the
// color with a match (a jump table, since the cases are dense) and sets up the
// next band. Main keeps running and shows the frame count.
//
// c64.kernal_off() switches the KERNAL off, so the CPU takes interrupts through
// the vectors at $FFFA (NMI) and $FFFE (IRQ) in RAM, and handlers end with rti.
// c64.set_irq installs the handler; kernal_off has already installed one for the
// NMI that does nothing, so RESTORE is ignored.
//
// The bars are not stabilized: the color changes about 60 cycles after the
// interrupt, near the end of the line, and that edge jitters by a few cycles
// depending on which instruction main was running when the interrupt came.
// A stable raster needs a double-IRQ or timer trick, beyond this example.
import c64
import text

const FIRST_LINE = 50
const BAND = 24

var band: u8
var frames: u8

data title = screen"RASTER BARS   FRAME $"

// Tells the VIC-II the raster interrupt was handled (and clears one that is
// pending). Main and the handler both call it: it has no memory of its own, so
// sharing it is safe.
inline fn acknowledge() { c64.vic.irq_status = 1 }

interrupt fn raster() {
    acknowledge()
    indexed match band {
        0 => c64.vic.border = c64.RED
        1 => c64.vic.border = c64.ORANGE
        2 => c64.vic.border = c64.YELLOW
        3 => c64.vic.border = c64.GREEN
        4 => c64.vic.border = c64.CYAN
        5 => c64.vic.border = c64.BLUE
        6 => c64.vic.border = c64.PURPLE
        7 => c64.vic.border = c64.LIGHT_GREY
    }
    band += 1
    if band == 8 {
        band = 0
        frames += 1
    }
    c64.vic.raster = FIRST_LINE + (band << 4) + (band << 3)   // band * 24
}

fn main() {
    c64.kernal_off()                    // also holds interrupts off
    c64.set_irq(addr(raster))
    c64.vic.control1 = c64.vic.control1 & $7F   // raster line bit 8 = 0
    c64.vic.raster = FIRST_LINE
    c64.vic.irq_enable = 1              // raster interrupt on
    acknowledge()
    c64.interrupts_on()

    c64.vic.background = c64.BLACK
    text.put(c64.SCREEN + 12 * 40 + 8, addr(title), len(title))
    while true {
        text.hex8(c64.SCREEN + 12 * 40 + 29, frames)
    }
}
