// A small font for a game's status line, and its encoding (spec 2.1). The glyphs are in the order
// the game needs them, not in PETSCII order; the encoding says which glyph each character is, so
// the game's text stays readable: hudfont.hud"SCORE" instead of [17, 11, 15, 16, 12].

encoding hud {
    ' '       = 0
    '0'..='9' = 1               // in order, so '0' + digit is the digit's glyph
    'C' = 11, 'E' = 12, 'I' = 13, 'L' = 14
    'O' = 15, 'R' = 16, 'S' = 17, 'V' = 18
    '♥'       = 19
}

// 8 bytes per glyph, top row first.
data glyphs: [u8; 160] = [
    $00, $00, $00, $00, $00, $00, $00, $00,     // ' '
    $3C, $66, $6E, $76, $66, $66, $3C, $00,     // 0
    $18, $38, $18, $18, $18, $18, $7E, $00,     // 1
    $3C, $66, $06, $0C, $30, $60, $7E, $00,     // 2
    $3C, $66, $06, $1C, $06, $66, $3C, $00,     // 3
    $0C, $1C, $3C, $6C, $7E, $0C, $0C, $00,     // 4
    $7E, $60, $7C, $06, $06, $66, $3C, $00,     // 5
    $3C, $66, $60, $7C, $66, $66, $3C, $00,     // 6
    $7E, $66, $0C, $18, $18, $18, $18, $00,     // 7
    $3C, $66, $66, $3C, $66, $66, $3C, $00,     // 8
    $3C, $66, $66, $3E, $06, $66, $3C, $00,     // 9
    $3C, $66, $60, $60, $60, $66, $3C, $00,     // C
    $7E, $60, $60, $78, $60, $60, $7E, $00,     // E
    $3C, $18, $18, $18, $18, $18, $3C, $00,     // I
    $60, $60, $60, $60, $60, $60, $7E, $00,     // L
    $3C, $66, $66, $66, $66, $66, $3C, $00,     // O
    $7C, $66, $66, $7C, $78, $6C, $66, $00,     // R
    $3C, $66, $60, $3C, $06, $66, $3C, $00,     // S
    $66, $66, $66, $66, $66, $3C, $18, $00,     // V
    $36, $7F, $7F, $7F, $3E, $1C, $08, $00,     // ♥
]
