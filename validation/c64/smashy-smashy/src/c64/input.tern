// Joystick in port 2 and the Run/Stop and F1 keys (read from the keyboard matrix), with edge detection.
// Port of ../src/input.p8. SCRIPTED = true replays the `script` table instead of reading $DC00 (self-testing
// only; keep false in builds for the designer).
import c64
import levelgen

const SCRIPTED: bool = false

// joystick bits, 1 = active
const UP: u8 = 0b00001
const DOWN: u8 = 0b00010
const LEFT: u8 = 0b00100
const RIGHT: u8 = 0b01000
const FIRE: u8 = 0b10000
// keys, in the same bit set
const STOP: u8 = 0b0100000          // Run/Stop
const F1: u8 = 0b1000000

var held: u8        // bits held this frame
var pressed: u8     // bits that went from released to held this frame (fire, down and the keys use this)
var prev: u8

// (frames to hold, joystick bits) pairs. A 0 frame count ends the script; input is released after that.
// Self-tests may point `script` at their own table.
data default_script: [u8; _] = [
    100, 0,
    0, 0,
]
var script: ptr u8 = addr(default_script)
var script_pos: u8 = 0
var script_left: u8 = 0

fn read() {
    var joy: u8 = 0
    if SCRIPTED {
        joy = scripted()
    } else {
        joy = read_ports()
    }
    pressed = joy & ~prev
    held = joy
    prev = joy
}

fn read_ports() -> u8 {
    var joy: u8 = ~c64.cia1.port_a & 0b0001_1111
    // Keyboard matrix: a 0 on a port A bit selects a row, port B shows its keys (0 = down).
    // Run/Stop is row 7 bit 7, F1 row 0 bit 4. The KERNAL IRQ doesn't run, so nothing else scans.
    c64.cia1.port_a = 0b0111_1111
    if c64.cia1.port_b & 0b1000_0000 == 0 {
        joy |= STOP
    }
    c64.cia1.port_a = 0b1111_1110
    if c64.cia1.port_b & 0b0001_0000 == 0 {
        joy |= F1
    }
    c64.cia1.port_a = $FF
    return joy
}

fn scripted() -> u8 {
    while script_left == 0 {
        if script[script_pos] == 0 {
            return 0
        }
        script_left = script[script_pos]
        script_pos += 2
    }
    script_left -= 1
    return script[script_pos - 1]
}

fn seed_random() {
    // Seed the level generator's random numbers when fire starts a game on the title or an attract page
    // (spec section 7). As math.rndseed(mkword(c64.CIA1TAL, c64.RASTER), mkword(c64.RASTER, c64.CIA1TAH)).
    levelgen.rnd_b = c64.vic.raster
    levelgen.rnd_a = c64.cia1.timer_a.hi
    levelgen.rnd_c = c64.cia1.timer_a.lo
    levelgen.rnd_x = c64.vic.raster
}
