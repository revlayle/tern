// Player-missile graphics reused down the screen: 8 objects (the player and 5 enemies, 8 x 16; two score
// popups, 16 x 8, each two slots wide) on 5 slots (players 0-3, and the 4 missiles side by side as a fifth
// player in PF3's colour). A slot shows another object lower down once a display-list interrupt has moved
// it, at the end of the character row above that object, so two objects share a slot when no character
// row has both. When a row would need more than 5 slots, one object is left out of that frame, a
// different one each frame (measured on the C64 build's play: 37 frames in 26,641, gaps.md).
//
// The DLI's moves land a few lines into the next row: the OS's NMI dispatch, the handler's register saves
// and its table lookups take about 100 cycles before its WSYNC, and a mode 4 line leaves the CPU about 60
// (the first line of a row about 20). So an object whose top is in the first LATE_LINES lines of its row
// is moved at the end of the row before, and needs its slot free from there ("need" row below).
//
// The game writes shadows (set_actor, set_wide, hide); render(), from video.wait_frame(), draws them into
// the copy of player-missile memory not on show and works out the DLIs' table; the VBI then shows that
// copy (PMBASE) and sets each slot's first object. Nothing is drawn where the beam is.
import atari
import mem
import assets

const OBJECTS: u8 = 8
const FIRST_WIDE: u8 = 6            // objects 6 and 7 are two slots wide (the popups)
const SLOTS: u8 = 5
const MISSILES: u8 = 4              // the fifth slot
const PF_ROWS: u8 = 24              // playfield character rows
const TOP_LINE: u8 = 38             // the scan line of playfield y 0 (VSCROL 2; the shake adds dy)
const ACTOR_H: u8 = 16
const WIDE_H: u8 = 8
const ENTRIES: u8 = 12              // per copy: at most one per object after the first in each slot
const LATE_LINES: u8 = 4            // lines into a row by which the DLI's moves have landed

// ---- shadows, written by the game ----
var gfx_of: [ptr u8; OBJECTS]       // each object's graphics: ACTOR_H bytes, or 2 x WIDE_H for a wide one
var color: [u8; OBJECTS]
var x: [u16; OBJECTS]               // playfield x of the left edge (hi-res pixels; may be a little negative)
var y: [u8; OBJECTS]                // playfield y of the top
var ena: u8                         // bit n: object n is shown
var dy: u8                          // the shake: lines added to every object
var wide_gfx: [u8; 2 * 2 * WIDE_H]  // the popups' graphics: per popup the left half's rows, then the right's
data bit: [u8; _] = [1, 2, 4, 8, 16, 32, 64, 128]

// Actor graphics from sprites.bin: the C64 multicolour sprites' left 8 pixels, rows 0-15. A pixel is on
// where the C64 shows its own colour (10) or the outline (11): the high bit of each pair.
data sprites_bin = include_bytes("../../data/sprites.bin")
const fn hi_bits(b: int) -> int {
    return ((b >> 4) & 8) | ((b >> 3) & 4) | ((b >> 2) & 2) | ((b >> 1) & 1)
}
const fn sprite_row(i: int) -> int {
    var at = (i >> 4) * 64 + (i & 15) * 3
    return hi_bits(sprites_bin[at]) << 4 | hi_bits(sprites_bin[at + 1])
}
data gfx: [u8; _] = [sprite_row(i) for i in 0..assets.SPRITE_COUNT * 16]

fn set_actor(n: u8, frame: u8, c: u8, px: u16, py: u8) {
    gfx_of[n] = addr(gfx) + ((frame - assets.SPR_PLAYER_RUN_R_0) as u16 << 4)
    color[n] = c
    x[n] = px
    y[n] = py
    ena |= bit[n]
}

fn set_wide(n: u8, c: u8, px: u16, py: u8) {
    gfx_of[n] = addr(wide_gfx) + ((n - FIRST_WIDE) << 4)
    color[n] = c
    x[n] = px
    y[n] = py
    ena |= bit[n]
}

fn hide(n: u8) {
    ena &= ~bit[n]
}

// ---- two copies of everything the screen reads ----
// Single-line player-missile memory: each copy 2 KB, missiles at +$300, players 0-3 at +$400 to +$700.
noinit var pm: [u8; 4096] @ align(2048)
data slot_page: [u8; SLOTS] = [4, 5, 6, 7, 3]

var shown: u8                       // the copy on show, 0 or 1: set by vbi()
var ready: bool                     // render() has finished the other copy: vbi() shows it
var shown_rows: u8                  // shown * (PF_ROWS + 1), the DLI's base into row_first
// Per copy: each slot's first object (set by the VBI), then the DLI's moves: entries in row order, and
// for each row r the first entry the DLI at its end applies (row_first[r] to row_first[r + 1]).
var init_hpos: [u8; 2 * SLOTS]
var init_col: [u8; 2 * SLOTS]
var ent_slot: [u8; 2 * ENTRIES]
var ent_hpos: [u8; 2 * ENTRIES]
var ent_col: [u8; 2 * ENTRIES]
var row_first: [u8; 2 * (PF_ROWS + 1)]
var ent_row: [u8; ENTRIES]          // render()'s working list: the row each entry is for
// Per copy: what render() drew there, cleared the next time it draws that copy.
var clr_at: [ptr u8; 2 * 10]
var clr_n: [u8; 2 * 10]
var clr_count: [u8; 2]

// render()'s working state
var clr_base: u8                    // the copy being drawn's offset into clr_at/clr_n: 0 or 10 ...
var ent_base: u8                    // ... into the entries: 0 or ENTRIES
var slot_base: u8                   // ... into init_hpos/init_col: 0 or SLOTS
var row_base: u8                    // ... into row_first: 0 or PF_ROWS + 1
var order: [u8; OBJECTS]            // shown objects, sorted by need row
var need_row: [u8; OBJECTS]         // the first row the object's slot must be free in: its top row, or the
                                    // row above when its top is in the first LATE_LINES lines of its row
var last_row: [u8; OBJECTS]
var slot_a: [u8; OBJECTS]           // the object's slot ($FF: left out this frame) ...
var slot_b: [u8; OBJECTS]           // ... and a wide object's right half
var slot_end: [u8; SLOTS]           // top-down: the row after the slot's lowest object so far
var slot_top: [u8; SLOTS]           // bottom-up: the need row of the slot's highest object so far
var bottom_up: bool                 // alternates, so a different object is left out each frame
var prev_mark: u8                   // the mark take_slot() replaced, for give_back()
const NONE: u8 = $FF

fn init() {
    mem.fill(addr(pm), 0, len(pm))
    atari.gtia.gractl = 3           // players and missiles from DMA
    atari.gprior = $11              // players over the playfield; the missiles as a fifth player (PF3)
    for s in 0..4 {
        atari.gtia.sizep[s] = 0
    }
    atari.gtia.sizem = 0
}

fn render() {
    // Draw the shadows into the copy not on show; the next VBI shows it.
    ready = false                   // a copy finished earlier but not shown yet is drawn again
    var b: u8 = shown ^ 1
    clr_base = 0
    ent_base = 0
    slot_base = 0
    row_base = 0
    if b != 0 {
        clr_base = 10
        ent_base = ENTRIES
        slot_base = SLOTS
        row_base = PF_ROWS + 1
    }
    clear_copy(b)
    var n: u8 = sort_shown()
    assign(n)
    draw_and_list(b, n)
    ready = true
}

fn clear_copy(b: u8) {
    var c: u8 = clr_base
    for _ in 0..clr_count[b] {
        mem.fill(clr_at[c], 0, clr_n[c] as u16)
        c += 1
    }
    clr_count[b] = 0
}

fn sort_shown() -> u8 {
    // The shown objects into `order` by need row (insertion sort; at most 8), with their rows. Returns how many.
    var n: u8 = 0
    for k in 0..OBJECTS {
        if ena & bit[k] == 0 {
            continue
        }
        var top: u8 = y[k]
        var h: u8 = ACTOR_H
        if k >= FIRST_WIDE {
            h = WIDE_H
        }
        need_row[k] = 0
        if top >= LATE_LINES {
            need_row[k] = (top - LATE_LINES) >> 3
        }
        last_row[k] = (top + h - 1) >> 3
        var i: u8 = n
        while i != 0 && need_row[order[i - 1]] > need_row[k] {
            order[i] = order[i - 1]
            i -= 1
        }
        order[i] = k
        n += 1
    }
    return n
}

fn assign(n: u8) {
    // Give each object a slot (two for a wide one) that no object in its rows has. Top-down on one frame,
    // bottom-up on the next: an object that does not fit is the last one met in a full row.
    for s in 0..SLOTS {
        slot_end[s] = 0
        slot_top[s] = NONE
    }
    bottom_up = !bottom_up
    for j in 0..n {
        var k: u8 = order[j]
        if bottom_up {
            k = order[n - 1 - j]
        }
        slot_a[k] = take_slot(k)
        slot_b[k] = NONE
        if k >= FIRST_WIDE && slot_a[k] != NONE {
            slot_b[k] = take_slot(k)
            if slot_b[k] == NONE {
                give_back(slot_a[k])
                slot_a[k] = NONE
            }
        }
    }
}

fn take_slot(k: u8) -> u8 {
    // The first slot free for object k's rows, marked as taken; NONE when there is none.
    for s in 0..SLOTS {
        if bottom_up {
            if last_row[k] < slot_top[s] {
                prev_mark = slot_top[s]
                slot_top[s] = need_row[k]
                return s
            }
        } else if need_row[k] >= slot_end[s] {
            prev_mark = slot_end[s]
            slot_end[s] = last_row[k] + 1
            return s
        }
    }
    return NONE
}

fn give_back(s: u8) {
    // Undo the last take_slot()'s mark on slot s (a wide object that found only one slot).
    if bottom_up {
        slot_top[s] = prev_mark
    } else {
        slot_end[s] = prev_mark
    }
}

fn draw_and_list(b: u8, n: u8) {
    // In need-row order: draw each placed object into copy b, and list where each slot's objects go: the
    // first for the VBI, the others for the DLI at the end of the row before their need row.
    var used: u8 = 0                // bit s: slot s has its first object
    var e: u8 = 0                   // entries so far
    var base: u8 = slot_base
    for s in 0..SLOTS {
        init_hpos[base + s] = 0     // an unused slot stays off the screen's left edge
        init_col[base + s] = 0
    }
    for j in 0..n {
        var k: u8 = order[j]
        if slot_a[k] == NONE {
            continue
        }
        var hpos: u8 = ((x[k] + 96) >> 1) as u8     // colour clock 48 is the playfield's left edge
        var line: u8 = TOP_LINE + y[k] + dy
        var src: ptr u8 = gfx_of[k]
        var h: u8 = ACTOR_H
        if k >= FIRST_WIDE {
            h = WIDE_H
        }
        for half in 0..2 {
            var s: u8 = slot_a[k]
            if half == 1 {
                s = slot_b[k]
                if s == NONE {
                    break
                }
            }
            draw(b, s, line, src, h)
            if used & bit[s] == 0 {
                used |= bit[s]
                init_hpos[base + s] = hpos
                init_col[base + s] = color[k]
            } else if e != ENTRIES {
                ent_row[e] = need_row[k] - 1
                ent_slot[ent_base + e] = s
                ent_hpos[ent_base + e] = hpos
                ent_col[ent_base + e] = color[k]
                e += 1
            }
            src += h
            hpos += 8
        }
    }
    sort_entries(b, e)
}

fn sort_entries(b: u8, e: u8) {
    // Entries come in their objects' need-row order already; sort them by row anyway (insertion sort, at
    // most 12: cheap when sorted), then index them.
    var o: u8 = ent_base
    for i in 1..e {
        var j: u8 = i
        while j != 0 && ent_row[j - 1] > ent_row[j] {
            swap(j - 1, j, o)
            j -= 1
        }
    }
    var r0: u8 = row_base
    var i: u8 = 0
    for r in 0..=PF_ROWS {
        while i != e && ent_row[i] < r {
            i += 1
        }
        row_first[r0 + r] = o + i
    }
}

fn swap(i: u8, j: u8, o: u8) {
    var t: u8 = ent_row[i]
    ent_row[i] = ent_row[j]
    ent_row[j] = t
    t = ent_slot[o + i]
    ent_slot[o + i] = ent_slot[o + j]
    ent_slot[o + j] = t
    t = ent_hpos[o + i]
    ent_hpos[o + i] = ent_hpos[o + j]
    ent_hpos[o + j] = t
    t = ent_col[o + i]
    ent_col[o + i] = ent_col[o + j]
    ent_col[o + j] = t
}

fn draw(b: u8, s: u8, line: u8, src: ptr u8, h: u8) {
    // h rows of graphics into slot s of copy b from scan line `line`, noted for clearing.
    var dst: ptr u8 = addr(pm) + (((b << 3) + slot_page[s]) as u16 << 8) + line
    for r in 0..h {
        dst[r] = src[r]
    }
    var c: u8 = clr_base + clr_count[b]
    clr_at[c] = dst
    clr_n[c] = h
    clr_count[b] += 1
}

fn vbi() {
    // In the frame interrupt: show the copy render() finished, and set each slot's first object.
    if ready {
        ready = false
        shown ^= 1
    }
    var page: u8 = addr(pm).hi
    if shown != 0 {
        page += 8
    }
    atari.antic.pmbase = page
    shown_rows = 0
    var base: u8 = 0
    if shown != 0 {
        shown_rows = PF_ROWS + 1
        base = SLOTS
    }
    for s in 0..4 {
        atari.gtia.hposp[s] = init_hpos[base + s]
        atari.gtia.colpm[s] = init_col[base + s]
    }
    set_missiles(init_hpos[base + MISSILES])
}

fn set_missiles(h: u8) {
    // The fifth player: missile 3 is its left 2 pixels (bits 7-6 of the missiles' byte), missile 0 its right.
    atari.gtia.hposm[3] = h
    atari.gtia.hposm[2] = h + 2
    atari.gtia.hposm[1] = h + 4
    atari.gtia.hposm[0] = h + 6
}
