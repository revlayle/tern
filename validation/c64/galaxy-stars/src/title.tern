// Title and game-over screens (spec section 11). Port of ../src/title.p8.
// Title: GALAXY STARS in big letters made of star chars. The stars fly in from off the screen (7 sprites, one
// star each) in random order and each becomes its logo char where it lands, with a short white sparkle. Then
// the logo twinkles (random chars flash white) and a color band rolls through it. The player star spins under
// the logo, PRESS FIRE blinks, the session high score below. Hi-res character mode, so the logo chars can use
// all 16 colors. Shown until fire (true) or for SHOW_FRAMES after the logo is built (false).
import mem
import video
import input
import score
import stars
import player
import assets

// [TUNE]
const SHOW_FRAMES: u16 = 400        // 8 s after the logo is built
const FLY_FRAMES: u8 = 8            // frames a star takes from off the screen to its place
const FLY_SHIFT = 3                 // ... as a shift: dividing by FLY_FRAMES
const FLIERS: u8 = 7                // sprites 1-7 (sprite 0 is the player star)
const SPARKLE_FRAMES: u8 = 2        // a landed star flashes white this long
const SWEEP_FRAMES: u8 = 3          // the color band moves one step every 3 frames
const TWINKLES: u8 = 3              // chars flashing white at a time (at most)
const TWINKLE_ON: u8 = 3            // frames a twinkle stays white
const TWINKLE_GAP: u8 = 16          // then a random wait of 0-15 frames
const FLASH_COLOR: u8 = 1           // white
data fly_color: [u8; _] = [1, 7]    // white and yellow fliers, alternating
// colors by (column + row - phase) & 15: yellow, with a band of orange, white and light blue rolling through
data sweep: [u8; 16] = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 8, 1, 14, 1, 8, 7]

const FIRE_ROW: u8 = 19
const FIRE_COL: u8 = 15
const HIGH_ROW: u8 = 22
const HIGH_COL: u8 = 10
const TEXT_COLOR: u8 = 1
const BLINK_FRAMES: u8 = 25         // PRESS FIRE on 25 frames, off 25
const SPECKS: u8 = 40
// the spinning star: playfield coordinates of the sprite's top-left (art centre on px 160, between the logo
// and PRESS FIRE)
const STAR_X: u16 = 150
const STAR_Y: u8 = 118

data press_fire = screen"PRESS FIRE\0"
data high_score = screen"HIGH SCORE\0"
data game_over_text = screen"GAME OVER\0"

// ---- the logo ----
// Letter shapes, 3 x 5: '#' = a star char, '.' = empty, rows separated by spaces.
data sh_g = ".## #.. #.# #.# .##\0"
data sh_a = ".#. #.# ### #.# #.#\0"
data sh_l = "#.. #.. #.. #.. ###\0"
data sh_x = "#.# #.# .#. #.# #.#\0"
data sh_y = "#.# #.# .#. .#. .#.\0"
data sh_s = ".## #.. .#. ..# ##.\0"
data sh_t = "### .#. .#. .#. .#.\0"
data sh_r = "##. #.# ##. #.# #.#\0"
struct Letter { shape: ptr u8, col: u8, row: u8 }
data letters: [Letter; _] = [       // both words centred
    Letter { shape = addr(sh_g), col = 8, row = 3 },
    Letter { shape = addr(sh_a), col = 12, row = 3 },
    Letter { shape = addr(sh_l), col = 16, row = 3 },
    Letter { shape = addr(sh_a), col = 20, row = 3 },
    Letter { shape = addr(sh_x), col = 24, row = 3 },
    Letter { shape = addr(sh_y), col = 28, row = 3 },
    Letter { shape = addr(sh_s), col = 10, row = 10 },
    Letter { shape = addr(sh_t), col = 14, row = 10 },
    Letter { shape = addr(sh_a), col = 18, row = 10 },
    Letter { shape = addr(sh_r), col = 22, row = 10 },
    Letter { shape = addr(sh_s), col = 26, row = 10 },
]

const MAX_CELLS: u8 = 128
var cells: u8                       // star chars in the logo (parsed once)
var cell_off: [u16; MAX_CELLS]      // screen offset (row * 40 + column)
var cell_col: [u8; MAX_CELLS]
var cell_row: [u8; MAX_CELLS]
var cell_base: [u8; MAX_CELLS]      // (column + row) & 15, for the color band
var order: [u8; MAX_CELLS]          // landing order, shuffled every time

// flying stars, one per sprite 1-7
var f_cell: [u8; FLIERS]            // target cell, 255 = idle
var f_left: [u8; FLIERS]            // frames until it lands
var f_x: [i16; FLIERS]              // hardware sprite position
var f_y: [i16; FLIERS]
var f_dx: [i16; FLIERS]             // step per frame
var f_dy: [i16; FLIERS]
var sp_cell: [u8; FLIERS]           // the cell this flier landed on last, flashing white
var sp_left: [u8; FLIERS]
var next_cell: u8                   // next index in order to launch
var landed: u8

var tw_cell: [u8; TWINKLES]
var tw_on: [u8; TWINKLES]
var tw_wait: [u8; TWINKLES]
var phase: u8                       // color band position

fn parse_logo() {
    for k in 0..len(letters) {
        var s: ptr u8 = letters[k].shape
        var i: u8 = 0
        var r: u8 = 0
        var c: u8 = 0
        while s[i] != 0 {
            match s[i] {
                ' ' => {
                    r += 1
                    c = 0
                }
                '#' => {
                    var row: u8 = letters[k].row + r
                    var col: u8 = letters[k].col + c
                    var w: u16 = row
                    cell_off[cells] = (w << 5) + (w << 3) + col     // row * 40 + col
                    cell_col[cells] = col
                    cell_row[cells] = row
                    cell_base[cells] = (col + row) & 15
                    cells += 1
                    c += 1
                }
                _ => c += 1
            }
            i += 1
        }
    }
}

fn run() -> bool {
    // Returns true when fire is pressed, false when the title's time is up.
    if cells == 0 {
        parse_logo()
    }
    video.hide_sprites()
    video.wait_frame()
    video.clear_screen()
    video.title_mode()
    // every logo char is on the screen from the start, black (unseen) until its star lands
    for i in 0..cells {
        var a: ptr u8 = video.SCREEN
        a += cell_off[i]
        a[0] = assets.CHAR_LOGO
        a += video.COLOR_RAM - video.SCREEN
        a[0] = video.COLOR_BG
    }
    for _ in 0..SPECKS {
        // on empty cells, but not the text rows
        var r: u8 = 0
        while true {
            r = stars.rand_below(25)
            if r != FIRE_ROW && r != HIGH_ROW {
                break
            }
        }
        var a: ptr u8 = video.row_addr(r)
        a += stars.rand_below(40)
        if a[0] == video.CHAR_SPACE {
            a[0] = video.speck_char[stars.rand_below(video.SPECK_KINDS)]
            a += video.COLOR_RAM - video.SCREEN
            a[0] = video.SPECK_COLOR
        }
    }
    video.message(HIGH_ROW, HIGH_COL, addr(high_score), TEXT_COLOR)
    var hs: ptr u8 = video.row_addr(HIGH_ROW) + (HIGH_COL + 11)
    video.put_score(hs, score.high_hi, score.high_mid, score.high_lo)
    mem.fill(hs + (video.COLOR_RAM - video.SCREEN), TEXT_COLOR, 8)

    // shuffle the landing order
    for i in 0..cells {
        order[i] = i
    }
    var i: u8 = cells - 1
    while i >= 1 {
        var j: u8 = stars.rand_below(i + 1)
        var t: u8 = order[i]
        order[i] = order[j]
        order[j] = t
        i -= 1
    }
    next_cell = 0
    landed = 0
    phase = 0
    for n in 0..FLIERS {
        f_cell[n] = 255
        sp_left[n] = 0
    }
    for n in 0..TWINKLES {
        tw_on[n] = 0
        tw_wait[n] = stars.rand_below(TWINKLE_GAP)
    }

    var built: bool = false
    var launch_t: u8 = 0            // the fliers start one frame apart
    var sweep_t: u8 = SWEEP_FRAMES
    var shown: u16 = 0
    var blink: u8 = 0
    var frame: u8 = 0
    var spin: u8 = 0
    var fire: bool = false
    while true {
        video.wait_frame()
        input.read()
        if input.pressed & input.FIRE != 0 {
            fire = true
            break
        }
        if !built {
            for n in 0..FLIERS {
                if sp_left[n] != 0 {
                    sp_left[n] -= 1
                    if sp_left[n] == 0 {
                        recolor(sp_cell[n])
                    }
                }
                if f_cell[n] != 255 {
                    f_left[n] -= 1
                    if f_left[n] == 0 {
                        land(n)
                        launch(n)
                    } else {
                        f_x[n] += f_dx[n]
                        f_y[n] += f_dy[n]
                        put_flier(n)
                    }
                }
            }
            if launch_t < FLIERS {
                launch(launch_t)
                launch_t += 1
            }
            if landed == cells {
                built = true
                for n in 0..FLIERS {
                    if sp_left[n] != 0 {
                        built = false
                    }
                }
            }
        } else {
            sweep_t -= 1
            if sweep_t == 0 {
                sweep_t = SWEEP_FRAMES
                phase += 1
                sweep_all()
            }
            twinkle()
            shown += 1
            if shown == SHOW_FRAMES {
                break
            }
        }

        spin += 1
        if spin == player.SPIN_DELAY {
            spin = 0
            frame += 1
            if frame == player.SPIN_FRAMES {
                frame = 0
            }
        }
        video.set_sprite(0, assets.SPR_PLAYER_0 + frame, player.COLOR, STAR_X, STAR_Y)
        if blink == 0 {
            video.message(FIRE_ROW, FIRE_COL, addr(press_fire), TEXT_COLOR)
        } else if blink == BLINK_FRAMES {
            video.message(FIRE_ROW, FIRE_COL, addr(press_fire), video.COLOR_BG)
        }
        blink += 1
        if blink == BLINK_FRAMES * 2 {
            blink = 0
        }
    }
    video.hide_sprites()
    return fire
}

fn recolor(c: u8) {
    var p: ptr u8 = video.COLOR_RAM
    p += cell_off[c]
    p[0] = sweep[(cell_base[c] - phase) & 15]
}

fn sweep_all() {
    // Recolor every logo char from the color band.
    for c in 0..cells {
        var p: ptr u8 = (video.COLOR_RAM + cell_off[c]) as ptr u8
        p[0] = sweep[(cell_base[c] - phase) & 15]
    }
}

fn launch(n: u8) {
    // Send flier n to the next cell in the order, from a random point just off a screen edge (hidden by
    // the border); idle and hidden when every cell has had its star.
    if next_cell == cells {
        f_cell[n] = 255
        video.hide_sprite(n + 1)
        return
    }
    var c: u8 = order[next_cell]
    next_cell += 1
    f_cell[n] = c
    f_left[n] = FLY_FRAMES
    // the sprite's art centre (frame pixel 10, 10) on the centre of the char
    var tx: i16 = ((cell_col[c] as i16) << 3) + (24 + 4 - 10)
    var ty: i16 = ((cell_row[c] as i16) << 3) + (50 + 4 - 10)
    var sx: i16 = 0
    var sy: i16 = 0
    match stars.rand_below(4) {
        0 => {
            sx = 0                  // left: the art is in the border's 24 px
            sy = (stars.rand_below(222) as i16) + 29
        }
        1 => {
            sx = 344                // right
            sy = (stars.rand_below(222) as i16) + 29
        }
        2 => {
            sx = (stars.rand_below(173) as i16) << 1
            sy = 29                 // top: the art ends above line 50
        }
        _ => {
            sx = (stars.rand_below(173) as i16) << 1
            sy = 250                // bottom: the art starts in the bottom border
        }
    }
    f_x[n] = sx
    f_y[n] = sy
    f_dx[n] = (tx - sx) >> FLY_SHIFT    // rounds down, as Prog8's signed / 8
    f_dy[n] = (ty - sy) >> FLY_SHIFT
    put_flier(n)
}

fn put_flier(n: u8) {
    var s: u8 = n + 1
    var bit: u8 = video.sprite_bit[s]
    var x: u16 = f_x[n] as u16
    video.spr_ptr[s] = assets.SPR_FLY
    video.spr_col[s] = fly_color[n & 1]
    video.spr_x[s] = x.lo
    video.spr_y[s] = (f_y[n] as u16).lo
    if x.hi != 0 {
        video.spr_msb |= bit
    } else {
        video.spr_msb &= ~bit
    }
    video.spr_ena |= bit
}

fn land(n: u8) {
    var c: u8 = f_cell[n]
    var p: ptr u8 = video.COLOR_RAM
    p += cell_off[c]
    p[0] = FLASH_COLOR
    sp_cell[n] = c
    sp_left[n] = SPARKLE_FRAMES
    landed += 1
}

fn twinkle() {
    // A few random logo chars flash white; after the color band's recolor, so they stay white.
    for n in 0..TWINKLES {
        if tw_on[n] != 0 {
            tw_on[n] -= 1
            if tw_on[n] == 0 {
                recolor(tw_cell[n])
            } else {
                flash(tw_cell[n])
            }
        } else if tw_wait[n] != 0 {
            tw_wait[n] -= 1
        } else {
            tw_cell[n] = stars.rand_below(cells)
            tw_on[n] = TWINKLE_ON
            tw_wait[n] = stars.rand_below(TWINKLE_GAP)
            flash(tw_cell[n])
        }
    }
}

fn flash(c: u8) {
    var p: ptr u8 = video.COLOR_RAM
    p += cell_off[c]
    p[0] = FLASH_COLOR
}

fn game_over() {
    // GAME OVER and the high score over the frozen playfield; fire after 1 s returns to the title.
    score.update_high()
    video.message(10, 15, addr(game_over_text), TEXT_COLOR)
    video.message(13, 10, addr(high_score), TEXT_COLOR)
    var hs: ptr u8 = video.row_addr(13) + 20
    hs[0] = video.CHAR_SPACE
    video.put_score(hs + 1, score.high_hi, score.high_mid, score.high_lo)
    mem.fill(hs + (video.COLOR_RAM - video.SCREEN), TEXT_COLOR, 9)
    for _ in 0..50 {
        video.wait_frame()
        input.read()
    }
    while true {
        video.wait_frame()
        input.read()
        if input.pressed & input.FIRE != 0 {
            return
        }
    }
}
