// Memory blocks: copy and fill. Whole pages first, then the rest.

// Copy count bytes from src to dst, first byte first. Overlapping blocks
// work only when dst is below src.
fn copy(dst: ptr u8, src: ptr u8, count: u16) {
    for _ in 0..count.hi {
        for i in 0..=255 using Y {
            dst[i] = src[i]
        }
        dst += 256
        src += 256
    }
    for i in 0..count.lo using Y {
        dst[i] = src[i]
    }
}

// Set count bytes at dst to value.
fn fill(dst: ptr u8, value: u8, count: u16) {
    for _ in 0..count.hi {
        for i in 0..=255 using Y {
            dst[i] = value
        }
        dst += 256
    }
    for i in 0..count.lo using Y {
        dst[i] = value
    }
}

// Copy count bytes from src to dst, last byte first. Overlapping blocks
// work when dst is above src (for dst below src use copy).
fn copy_back(dst: ptr u8, src: ptr u8, count: u16) {
    // Start at the whole pages' end: the loose bytes above them go first, then the pages from the top.
    var pages: u16 = (count.hi as u16) << 8
    dst += pages
    src += pages
    var i: u8 = count.lo
    while i != 0 {
        i -= 1
        dst[i] = src[i]
    }
    for _ in 0..count.hi {
        dst -= 256
        src -= 256
        var j: u8 = 0
        while true {
            j -= 1
            dst[j] = src[j]
            if j == 0 { break }
        }
    }
}
