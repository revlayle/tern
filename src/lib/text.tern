// Text in memory, platform independent. Texts are a pointer plus a length.
// Digits come from the digits module: C64 screen codes (the same as PETSCII for 0-9), or on the
// Atari ATASCII.

import digits

private const MINUS = $2D   // screen code of "-"
private data POWERS: [u16; 4] = [10000, 1000, 100, 10]

// Copy n bytes of text to dst, e.g. a screen"..." string to screen memory.
fn put(dst: ptr u8, src: ptr u8, n: u8) {
    for i in 0..n using Y {
        dst[i] = src[i]
    }
}

// Write value in decimal at dst, without leading zeros. Returns the number of digits (1 to 3).
fn dec8(dst: ptr u8, value: u8) -> u8 {
    var n: u8 = 0
    if value >= 100 {
        var d: u8 = digits.DIGITS[0]
        while value >= 100 {
            value -= 100
            d += 1
        }
        dst[0] = d
        n = 1
    }
    if value >= 10 || n != 0 {
        var d: u8 = digits.DIGITS[0]
        while value >= 10 {
            value -= 10
            d += 1
        }
        dst[n] = d
        n += 1
    }
    dst[n] = value + digits.DIGITS[0]
    return n + 1
}

// Write value in decimal at dst, without leading zeros. Returns the number of digits (1 to 5).
fn dec16(dst: ptr u8, value: u16) -> u8 {
    var n: u8 = 0
    for k in 0..4 {
        var power: u16 = POWERS[k]
        var d: u8 = 0
        while value >= power {
            value -= power
            d += 1
        }
        if d != 0 || n != 0 {
            dst[n] = digits.DIGITS[d]
            n += 1
        }
    }
    dst[n] = digits.DIGITS[value.lo]
    return n + 1
}

// Write value as 2 hex digits at dst.
fn hex8(dst: ptr u8, value: u8) {
    dst[0] = digits.DIGITS[value >> 4]
    dst[1] = digits.DIGITS[value & 15]
}

// Write value as 4 hex digits at dst.
fn hex16(dst: ptr u8, value: u16) {
    dst[0] = digits.DIGITS[value.hi >> 4]
    dst[1] = digits.DIGITS[value.hi & 15]
    dst[2] = digits.DIGITS[value.lo >> 4]
    dst[3] = digits.DIGITS[value.lo & 15]
}

// True if the n bytes at a and b are the same.
fn equal(a: ptr u8, b: ptr u8, n: u8) -> bool {
    for i in 0..n using Y {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// The index of the first ch in the n bytes at s, or $FF if there is none.
fn find(s: ptr u8, n: u8, ch: u8) -> u8 {
    for i in 0..n using Y {
        if s[i] == ch {
            return i
        }
    }
    return $FF
}

// Write value in decimal at dst, with a minus sign for a negative value, and no leading zeros.
// Returns the number of characters (1 to 4).
fn dec8s(dst: ptr u8, value: i8) -> u8 {
    if value < 0 {
        dst[0] = MINUS
        var magnitude: u8 = (0 - (value as u8))
        return dec8(dst + 1, magnitude) + 1
    }
    return dec8(dst, value as u8)
}

// Write value in decimal at dst, with a minus sign for a negative value, and no leading zeros.
// Returns the number of characters (1 to 6).
fn dec16s(dst: ptr u8, value: i16) -> u8 {
    if value < 0 {
        dst[0] = MINUS
        var magnitude: u16 = (0 - (value as u16))
        return dec16(dst + 1, magnitude) + 1
    }
    return dec16(dst, value as u16)
}

// Write value as exactly `width` decimal digits at dst, with leading zeros (width 1 to 5).
// The value must fit in that many digits; if it does not, the digits written are unspecified.
fn dec16z(dst: ptr u8, value: u16, width: u8) {
    for k in (5 - width)..4 {
        var power: u16 = POWERS[k]
        var d: u8 = 0
        while value >= power {
            value -= power
            d += 1
        }
        dst[0] = digits.DIGITS[d]
        dst += 1
    }
    dst[0] = digits.DIGITS[value.lo]
}

// Write value as exactly `width` decimal digits at dst, with leading zeros (width 1 to 3).
// The value must fit in that many digits.
fn dec8z(dst: ptr u8, value: u8, width: u8) {
    dec16z(dst, value as u16, width)
}
