// Arithmetic that needs a loop or tables: multiply, divide, shifts by a variable count.
// The operators *, / and % work only on constants (spec 3.1).

// The remainders of div8 and div16. Read them right after the call.
var remainder8: u8
var remainder16: u16

// Work bytes for the routines below.
private var w0: u8
private var w1: u8
private var w2: u8

// a * b. Shift-and-add: small, 151 to 183 cycles.
asm fn mul8(a: u8 using A, b: u8 using X) -> u16 {
    sta w0              // a
    stx w1              // b; its bits shift out as the product's low byte shifts in
    lda #0              // the product's high byte
    ldx #8
    lsr w1
.loop:
    bcc .skip
    clc
    adc w0
.skip:
    ror
    ror w1
    dex
    bne .loop
    tax
    lda w1
}

// a * b with quarter squares: a * b = f(a + b) - f(|a - b|), where f(x) = x * x / 4
// (rounded down; exact here, since a + b and a - b are both even or both odd).
// 65 to 73 cycles; adds 1 KB of tables.
asm fn mul8_fast(a: u8 using A, b: u8 using X) -> u16 {
    stx w0              // b
    sta w1              // a
    sec
    sbc w0
    bcs .positive
    eor #$FF            // b - a; the carry is clear, so this adds 1
    adc #1
.positive:
    tay                 // Y = |a - b|
    lda w1
    clc
    adc w0              // a + b: 9 bits, the 9th in the carry
    tax
    bcs .large
    lda SQUARE_LO,x
    sec
    sbc SQUARE_LO,y
    sta w2
    lda SQUARE_HI,x
    sbc SQUARE_HI,y
    tax
    lda w2
    rts
.large:
    lda SQUARE_LO2,x    // the carry is still set
    sbc SQUARE_LO,y
    sta w2
    lda SQUARE_HI2,x
    sbc SQUARE_HI,y
    tax
    lda w2
}

// m * n, the low 16 bits. Shift-and-add; stops when no bits of n are left.
asm fn mul16(m: u16, n: u16) -> u16 {
    lda #0
    sta w0              // the product
    sta w1
    beq .test
.loop:
    lsr n+1
    ror n
    bcc .shift
    clc
    lda w0
    adc m
    sta w0
    lda w1
    adc m+1
    sta w1
.shift:
    asl m
    rol m+1
.test:
    lda n
    ora n+1
    bne .loop
    lda w0
    ldx w1
}

// a / b, and a % b in remainder8. Shift-and-subtract. Division by zero gives no error.
asm fn div8(a: u8 using A, b: u8 using X) -> u8 {
    stx w0              // b
    sta w1              // a; its bits shift out as the quotient's bits shift in
    lda #0              // the remainder
    ldx #8
.loop:
    asl w1
    rol
    bcs .subtract       // 9 bits: larger than b
    cmp w0
    bcc .next
.subtract:
    sbc w0              // the carry is set
    inc w1
.next:
    dex
    bne .loop
    sta remainder8
    lda w1
}

// n / d, and n % d in remainder16. Shift-and-subtract. Division by zero gives no error.
asm fn div16(n: u16, d: u16) -> u16 {
    lda #0
    sta remainder16
    sta remainder16+1
    ldx #16
.loop:
    asl n               // n's bits shift out as the quotient's bits shift in
    rol n+1
    rol remainder16
    rol remainder16+1
    bcs .subtract       // 17 bits: larger than d
    lda remainder16
    cmp d
    lda remainder16+1
    sbc d+1
    bcc .next
.subtract:
    lda remainder16     // the carry is set
    sbc d
    sta remainder16
    lda remainder16+1
    sbc d+1
    sta remainder16+1
    inc n
.next:
    dex
    bne .loop
    lda n
    ldx n+1
}

// x << n, one shift per step.
asm fn shl8(x: u8 using A, n: u8 using X) -> u8 {
    cpx #0
    beq .done
.loop:
    asl
    dex
    bne .loop
.done:
}

// x >> n, one shift per step.
asm fn shr8(x: u8 using A, n: u8 using X) -> u8 {
    cpx #0
    beq .done
.loop:
    lsr
    dex
    bne .loop
.done:
}

// x << n, one shift per step.
asm fn shl16(x: u16 using AX, n: u8 using Y) -> u16 {
    cpy #0
    beq .done
    stx w0
.loop:
    asl
    rol w0
    dey
    bne .loop
    ldx w0
.done:
}

// x >> n, one shift per step.
asm fn shr16(x: u16 using AX, n: u8 using Y) -> u16 {
    cpy #0
    beq .done
    stx w0
.loop:
    lsr w0
    ror
    dey
    bne .loop
    ldx w0
.done:
}

