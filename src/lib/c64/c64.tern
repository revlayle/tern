// Commodore 64: screen and color memory, colors, and KERNAL routines.
// KERNAL routines are called directly in ROM (spec 6.6), so a call costs one jsr.
import io

const SCREEN = $0400            // 40 x 25 screen codes
const COLOR = $D800             // 40 x 25 color numbers

const BLACK = 0
const WHITE = 1
const RED = 2
const CYAN = 3
const PURPLE = 4
const GREEN = 5
const BLUE = 6
const YELLOW = 7
const ORANGE = 8
const BROWN = 9
const LIGHT_RED = 10
const DARK_GREY = 11
const GREY = 12
const LIGHT_GREEN = 13
const LIGHT_BLUE = 14
const LIGHT_GREY = 15

// Print one PETSCII character at the cursor (CHROUT).
fn chrout(ch: u8 using A) @ $FFD2 keeps X, Y

// Read a key from the keyboard buffer; 0 if there is none (GETIN).
fn getin() -> u8 using A @ $FFE4

// Move the text cursor (PLOT with the carry clear).
fn cursor(false using carry, row: u8 using X, col: u8 using Y) @ $FFF0

// The text cursor: the row in .lo, the column in .hi (PLOT with the carry set).
fn get_cursor(true using carry) -> u16 using XY @ $FFF0

// Print n PETSCII characters through CHROUT.
fn print(src: ptr u8, n: u8) {
    for i in 0..n using Y {
        chrout(src[i])
    }
}

// Load a file from disk to the address stored in the file (SETNAM, SETLFS with secondary address 1,
// LOAD). `name` points to n PETSCII characters; `device` is 8 for the first disk drive. Returns true
// when loading failed (the KERNAL's carry). Use it to load an overlay (spec 8.5): the file is the one
// the compiler wrote for the module, e.g. "LEVEL1" for level1.prg on the disk. The function is
// about 30 bytes, shared by all calls; the KERNAL's own work (disk access) takes far longer.
fn load(name: ptr u8, n: u8, device: u8) -> bool {
    io.setnam(n, name)
    io.setlfs(1, device, 1)         // logical file 1; secondary address 1: load to the address in the file
    return io.kernal_load_own()
}

// ---------- Hardware registers (volatile: every read and write happens) ----------

// VIC-II video chip at $D000.
struct Vic {
    sprite0_x: u8 @ $00, sprite0_y: u8, sprite1_x: u8, sprite1_y: u8
    sprite2_x: u8, sprite2_y: u8, sprite3_x: u8, sprite3_y: u8
    sprite4_x: u8, sprite4_y: u8, sprite5_x: u8, sprite5_y: u8
    sprite6_x: u8, sprite6_y: u8, sprite7_x: u8, sprite7_y: u8
    sprite_x_msb: u8 @ $10          // bit 8 of each sprite's x position
    control1: u8 @ $11              // bit 7: bit 8 of the raster line; vertical scroll, screen on, bitmap
    raster: u8 @ $12                // current raster line (read), raster interrupt line (write)
    light_pen_x: u8 @ $13
    light_pen_y: u8 @ $14
    sprite_enable: u8 @ $15
    control2: u8 @ $16              // horizontal scroll, 38/40 columns, multicolor
    sprite_expand_y: u8 @ $17
    memory: u8 @ $18                // screen and character memory
    irq_status: u8 @ $19
    irq_enable: u8 @ $1A
    sprite_priority: u8 @ $1B
    sprite_multicolor: u8 @ $1C
    sprite_expand_x: u8 @ $1D
    sprite_collision: u8 @ $1E      // sprite-sprite collisions
    sprite_bg_collision: u8 @ $1F   // sprite-background collisions
    border: u8 @ $20
    background: u8 @ $21
    background1: u8 @ $22
    background2: u8 @ $23
    background3: u8 @ $24
    sprite_mc0: u8 @ $25            // shared sprite multicolors
    sprite_mc1: u8 @ $26
    sprite_color: [u8; 8] @ $27
}
var vic: Vic @ $D000
// The sprite position registers as an array: x of sprite n at 2n, y at 2n + 1 (vic.sprite0_x ... vic.sprite7_y).
var sprite_xy: [u8; 16] @ $D000

// One SID voice.
struct Voice {
    freq: u16                       // frequency
    pulse: u16                      // pulse width (12 bits)
    control: u8                     // waveform, gate, sync, ring
    attack_decay: u8
    sustain_release: u8
}

// SID sound chip at $D400. Most registers can only be written.
struct Sid {
    voice1: Voice @ $00
    voice2: Voice @ $07
    voice3: Voice @ $0E
    cutoff: u16 @ $15               // filter cutoff: bits 0-2 in the low byte, bits 3-10 in the high byte
    resonance: u8 @ $17             // resonance and filter routing
    volume: u8 @ $18                // volume (bits 0-3) and filter mode
    paddle_x: u8 @ $19
    paddle_y: u8 @ $1A
    osc3: u8 @ $1B                  // voice 3 waveform output
    env3: u8 @ $1C                  // voice 3 envelope output
}
var sid: Sid @ $D400

// CIA chip: two ports, two timers, a time-of-day clock.
struct Cia {
    port_a: u8 @ $00
    port_b: u8 @ $01
    ddr_a: u8 @ $02                 // data direction of port A: 1 = output
    ddr_b: u8 @ $03
    timer_a: u16 @ $04
    timer_b: u16 @ $06
    tod_tenths: u8 @ $08
    tod_seconds: u8 @ $09
    tod_minutes: u8 @ $0A
    tod_hours: u8 @ $0B
    serial: u8 @ $0C
    icr: u8 @ $0D                   // interrupt control and status
    control_a: u8 @ $0E
    control_b: u8 @ $0F
}
var cia1: Cia @ $DC00               // keyboard, joysticks, timer interrupt
var cia2: Cia @ $DD00               // serial bus, VIC bank, NMI

// ---------- Interrupts ----------
//
// With the KERNAL switched off, the CPU takes interrupts through the vectors at $FFFE (IRQ) and
// $FFFA (NMI), which are then RAM and can point at Tern interrupt handlers (they end with rti).
//
//     c64.kernal_off()
//     c64.set_irq(addr(raster))
//     ... set up the interrupt source, e.g. the VIC-II raster interrupt ...
//     c64.interrupts_on()

// Switch the KERNAL and BASIC ROMs off ($01 = $35; I/O stays), so that interrupts go through the
// RAM vectors. Turns off the CIA interrupts the KERNAL used, and installs an NMI handler that does
// nothing, so RESTORE is ignored. Leaves interrupts disabled. KERNAL routines (chrout, getin,
// cursor) cannot be called afterwards.
asm fn kernal_off() {
    sei
    lda #$7F
    sta cia1.icr                    // no CIA 1 interrupts (the KERNAL's timer)
    sta cia2.icr                    // no CIA 2 NMIs
    lda cia1.icr                    // reading clears any that are pending
    lda cia2.icr
    lda #ignore_nmi.lo              // writes reach the RAM under the KERNAL ROM,
    sta $FFFA                       // so the NMI vector is ready before the ROM goes
    lda #ignore_nmi.hi              // (RESTORE is an NMI, which sei does not hold off)
    sta $FFFB
    lda #$35
    sta $01
    rts
}

private interrupt fn ignore_nmi() { }

// Install an IRQ handler: c64.set_irq(addr(handler)). The handler must be an 'interrupt fn' (it
// ends with rti); addr() is a plain u16, so this is not checked. Needs kernal_off first.
// Interrupts are held off while the vector changes.
asm fn set_irq(handler: u16 using XY) {
    php
    sei
    stx $FFFE
    sty $FFFF
    plp
    rts
}

// Install an IRQ handler with the KERNAL left in (needed by the io library): c64.set_kernal_irq(addr(handler)).
// The handler is an 'interrupt fn', as for set_irq. The KERNAL's IRQ entry pushes A, X and Y and
// jumps through $0314, which then points to a stub that pulls them again and jumps to the handler,
// so the handler runs as if called through $FFFE (about 20 cycles more than the KERNAL entry alone).
// The KERNAL's own IRQ work (keyboard scan, clock) no longer runs, so getin() sees no new keys. The
// handler acknowledges its interrupt source; the KERNAL's CIA 1 timer interrupt is still on and
// reaches it too, so turn it off for a raster interrupt alone: c64.cia1.icr = $7F.
// Interrupts are held off while the vector changes.
asm fn set_kernal_irq(handler: u16 using XY) {
    php
    sei
    stx kernal_handler
    sty kernal_handler+1
    lda #kernal_entry.lo
    sta $0314
    lda #kernal_entry.hi
    sta $0315
    plp
    rts
}

private var kernal_handler: u16

// Reached through $0314: undoes the KERNAL entry's pushes of A, X and Y, then goes to the handler.
private asm fn kernal_entry() {
    pla
    tay
    pla
    tax
    pla
    jmp (kernal_handler)
}

// Install an NMI handler: c64.set_nmi(addr(handler)). The handler must be an 'interrupt fn'.
// Needs kernal_off first. An NMI cannot be held off, so install it before anything raises one
// (CIA 2, RESTORE).
asm fn set_nmi(handler: u16 using XY) {
    stx $FFFA
    sty $FFFB
    rts
}

// Allow IRQs (cli).
inline asm fn interrupts_on() {
    cli
}

// Hold IRQs off (sei). NMIs still happen.
inline asm fn interrupts_off() {
    sei
}
