// Sixteen enemies: the new position is added in place and the bounce tests read it back.
struct Enemy { x: u8, y: u8, dx: i8, dy: i8, hits: u8 }
var enemies: [Enemy; 16]
var bounces: u16

fn main() {
    for i in 0..16 {
        enemies[i].x = (i << 3) + i + 10
        enemies[i].y = (i << 2) + i + 20
        enemies[i].dx = 1
        enemies[i].dy = -2
    }
    for _ in 0..50 {
        for i in 0..16 {
            enemies[i].x += enemies[i].dx as u8
            if enemies[i].x < 8 || enemies[i].x > 200 {
                enemies[i].dx = -enemies[i].dx
                enemies[i].hits += 1
                bounces += 1
            }
            enemies[i].y += enemies[i].dy as u8
            if enemies[i].y < 16 || enemies[i].y > 180 {
                enemies[i].dy = -enemies[i].dy
                bounces += 1
            }
        }
    }
}
