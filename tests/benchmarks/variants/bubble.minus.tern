// Bubble sort with the pair written as values[i - 1], values[i] (a constant offset below the index folds into the address).
const N = 100
var values: [u8; N]

fn main() {
    var x: u8 = 7
    for i in 0..N {
        x = (x << 2) + x + 17
        values[i] = x
    }
    var last: u8 = N - 1
    while last > 0 {
        for i in 1..=last {
            var a: u8 = values[i - 1]
            var b: u8 = values[i]
            if a > b {
                values[i - 1] = b
                values[i] = a
            }
        }
        last -= 1
    }
}
