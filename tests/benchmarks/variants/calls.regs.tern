// Small calls with the parameters in registers (using A, X, Y), as the assembly version passes them.
var total: u16
var clamped: u8

fn add3(a: u8 using A, b: u8 using X, c: u8 using Y) -> u8 {
    return a + b + c
}

fn clamp(v: u8 using A, top: u8 using X) -> u8 {
    if v > top { return top }
    return v
}

fn bigger(a: u8 using A, b: u8 using X) -> bool {
    return a > b
}

fn main() {
    for i in 0..200 {
        var s: u8 = add3(i, i >> 1, 3)
        total += s as u16
        clamped = clamp(s, 150)
        if bigger(s, 100) { total += 1 }
    }
}
