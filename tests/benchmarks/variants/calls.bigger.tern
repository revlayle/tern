// calls, with only bigger as an inline fn: the comparison becomes the caller's branch.
var total: u16
var clamped: u8

fn add3(a: u8, b: u8, c: u8) -> u8 {
    return a + b + c
}

fn clamp(v: u8 using A, top: u8) -> u8 {
    if v > top { return top }
    return v
}

inline fn bigger(a: u8, b: u8) -> bool {
    return a > b
}

fn main() {
    for i in 0..200 {
        var s: u8 = add3(i, i >> 1, 3)
        total += s as u16
        clamped = clamp(s, 150)
        if bigger(s, 100) { total += 1 }
    }
}
