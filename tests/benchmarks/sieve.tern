// Sieve of Eratosthenes: the primes below 256.
var composite: [u8; 256]
var count: u8

fn main() {
    var n: u8 = 2
    while n < 16 {
        if composite[n] == 0 {
            // Any non-zero value marks a number: store m itself.
            for m in (n << 1)..=255 step n using Y {
                composite[m] = m
            }
        }
        n += 1
    }
    for i in 2..=255 {
        if composite[i] == 0 { count += 1 }
    }
}
