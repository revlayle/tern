// Sieve of Eratosthenes: the primes below 256.
var composite: [u8; 256]
var count: u8

fn main() {
    var n: u8 = 2
    while n < 16 {
        if composite[n] == 0 {
            var m: u16 = (n as u16) << 1
            while m < 256 {
                composite[m.lo] = 1
                m += n as u16
            }
        }
        n += 1
    }
    for i in 2..=255 {
        if composite[i] == 0 { count += 1 }
    }
}
